{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Distribution of Digital Inclusion Levels in Australia (2025)",
    "fontSize": 18,
    "anchor": "middle"
  },
  "width": 520,
  "height": 300,
  "data": {
    "url": "data/digital_inclusion_national_2025.csv"
  },
  "transform": [
    {
      "calculate": "datum.category === 'Highly excluded' ? 0 : datum.category === 'Excluded' ? 1 : 2",
      "as": "category_order"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "percentage",
          "as": "cumulative"
        }
      ],
      "sort": [
        {
          "field": "category_order",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.cumulative - datum.percentage",
      "as": "start"
    },
    {
      "calculate": "round(datum.cumulative)",
      "as": "end"
    },
    {
      "calculate": "round(datum.start)",
      "as": "begin"
    },
    {
      "calculate": "sequence(datum.begin, datum.end)",
      "as": "squares"
    },
    {
      "flatten": ["squares"]
    },
    {
      "calculate": "datum.squares % 10",
      "as": "column"
    },
    {
      "calculate": "floor(datum.squares / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 3,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Highly excluded",
          "Excluded",
          "Included or highly included"
        ],
        "range": [
          "#C45140",
          "#E5A15D",
          "#367FB4"
        ]
      },
      "legend": {
        "title": "Digital Inclusion Category",
        "labelFontSize": 13,
        "titleFontSize": 14,
        "orient": "bottom"
      }
    },
    "tooltip": [
      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Share (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
