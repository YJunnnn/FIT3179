
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Dot density map of sampled NBN fixed-line coverage areas across Australia in 2024.",
  "width": 550,
  "height": 380,
  "title": {
    "text": "NBN Fixed-Line Coverage Distribution (2024)",
    "fontSize": 16,
    "anchor": "middle",
    "offset": 18
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 520
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F0F0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/chart4_dots.csv"
      },
      "mark": {
        "type": "circle",
        "size": 18,
        "color": "#3977A9",
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 148,
            "latitude": -34,
            "longitude2": 143,
            "latitude2": -29
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#333333",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "longitude2"
        },
        "latitude2": {
          "field": "latitude2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 143,
            "latitude": -29,
            "label": "Higher fixed-line coverage concentration"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#000000",
        "align": "right",
        "dx": -5,
        "dy": -8
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
