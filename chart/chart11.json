{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Comparison of devices used to access the internet in Australia in 2017 and 2025.",
  "title": {
    "text": "Devices Used to Access the Internet (2017 vs 2025)",
    "fontSize": 16,
    "anchor": "middle",
    "offset": 18
  },
  "width": 520,
  "height": 380,
  "data": {
    "url": "data/chart11_devices.csv"
  },
  "layer": [
    {
        "mark": {
        "type": "bar"
        }
    },
    {
  "transform": [
    {
      "filter": "datum.device === 'Smart TV' && datum.year == 2025"
    }
    ],
    "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 11,
        "fontWeight": "bold"
    },
    "encoding": {
        "text": {
        "value": "+33.1 points"
        },
        "color": {
        "value": "#000000"
        }
    }
    }
  ],
  "encoding": {
    "x": {
      "field": "device",
      "type": "nominal",
      "title": "Device Type",
      "sort": [
        "Mobile phone",
        "Laptop computer",
        "Smart TV",
        "Tablet",
        "Desktop computer"
      ],
      "axis": {
        "labelFontSize": 11,
        "titleFontSize": 13,
        "labelPadding": 10,
        "labelAngle": 0,
        "labelLimit": 110,
        "grid": false
      }
    },
    "xOffset": {
      "field": "year",
      "type": "nominal",
      "sort": ["2017", "2025"]
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "title": "Percentage of Respondents (%)",
      "scale": {
        "domain": [0, 100]
      },
      "axis": {
        "labelFontSize": 12,
        "titleFontSize": 13,
        "labelPadding": 8,
        "grid": true,
        "gridColor": "#E0E0E0"
      }
    },
    "color": {
      "field": "year",
      "type": "nominal",
      "title": "Year",
      "sort": ["2017", "2025"],
      "scale": {
        "domain": ["2017", "2025"],
        "range": ["#A6C8E0", "#3478AC"]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "labelFontSize": 12,
        "title": null
      }
    },
    "tooltip": [
      {
        "field": "device",
        "type": "nominal",
        "title": "Device"
      },
      {
        "field": "year",
        "type": "nominal",
        "title": "Year"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Respondents (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
