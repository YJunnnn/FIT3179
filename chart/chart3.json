{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Digital Ability Across Australia (2020)",
    "fontSize": 16,
    "anchor": "middle",
    "offset": 18
  },
  "width": 550,
  "height": 380,

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 520
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME21 !== 'Outside Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E8EEF2",
        "stroke": "#B9C6D0",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/digital_ability_states_2020.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {"state": "NSW", "longitude": 147.0, "latitude": -32.5},
                {"state": "VIC", "longitude": 144.5, "latitude": -37.0},
                {"state": "QLD", "longitude": 145.0, "latitude": -22.5},
                {"state": "SA", "longitude": 135.5, "latitude": -30.0},
                {"state": "WA", "longitude": 121.0, "latitude": -26.0},
                {"state": "TAS", "longitude": 146.5, "latitude": -42.0},
                {"state": "ACT", "longitude": 149.1, "latitude": -35.3},
                {"state": "NT", "longitude": 133.5, "latitude": -20.0}
              ]
            },
            "key": "state",
            "fields": ["longitude", "latitude"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#3977A9",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
            "field": "ability",
            "type": "quantitative",
            "title": "Digital Ability Index",
            "scale": {
                "domain": [45, 60],
                "range": [100, 1800]
            },
            "legend": {
                "orient": "bottom",
                "values": [45, 50, 55],
                "titleFontSize": 13,
                "labelFontSize": 12
            }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "ability",
            "type": "quantitative",
            "title": "Digital Ability Index",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 149,
            "latitude": -35.5,
            "longitude2": 151.5,
            "latitude2": -35.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#000000",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "longitude2"
        },
        "latitude2": {
          "field": "latitude2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 151.5,
            "latitude": -35.3,
            "label": "ACT: 55.7 (highest)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "dy": 0,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#000000"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 133.5,
            "latitude": -20.0,
            "longitude2": 133.5,
            "latitude2": -18.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#000000",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "longitude2"
        },
        "latitude2": {
          "field": "latitude2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 136.0,
            "latitude": -20.0,
            "label": "NT: 46.5 (lowest)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dx": 0,
        "dy": -15,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#000000"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
