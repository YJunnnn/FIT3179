{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 500,
  "height": 370,
  "title": {
    "text": "Digital Ability Across Australia (2020)",
    "fontSize": 16,
    "anchor": "middle"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME21 !== 'Outside Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E8EEF2",
        "stroke": "#B9C6D0",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/digital_ability_states_2020.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {"state": "NSW", "longitude": 147.0, "latitude": -32.5},
                {"state": "VIC", "longitude": 144.5, "latitude": -37.0},
                {"state": "QLD", "longitude": 145.0, "latitude": -22.5},
                {"state": "SA", "longitude": 135.5, "latitude": -30.0},
                {"state": "WA", "longitude": 121.0, "latitude": -26.0},
                {"state": "TAS", "longitude": 146.5, "latitude": -42.0},
                {"state": "ACT", "longitude": 149.1, "latitude": -35.3},
                {"state": "NT", "longitude": 133.5, "latitude": -20.0}
              ]
            },
            "key": "state",
            "fields": ["longitude", "latitude"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
            "field": "ability",
            "type": "quantitative",
            "title": "Digital Ability Index (0–100)",
            "scale": {
                "domain": [0, 60],
                "range": [0, 750]
            },
            "legend": {
                "orient": "bottom",
                "values": [40, 50, 60]
            }
        },
        "color": {
            "field": "ability",
            "type": "quantitative",
            "title": "Digital Ability Index (0–100)",
            "scale": {
                "domain": [45, 57],
                "range": ["#BBD7EB", "#175A91"]
            },
            "legend": {
                "orient": "bottom",
                "gradientLength": 200
            }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "ability",
            "type": "quantitative",
            "title": "Digital Ability Index",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
