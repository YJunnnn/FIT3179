{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Ranking of Online Activities in Australia (2020 – 2025)",
    "fontSize": 16,
    "anchor": "middle",
    "offset": 18
  },
  "width": 520,
  "height": 520,
  
  "data": {
    "url": "data/chart9_bump.csv"
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "percentage",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 90
        },
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "sort": "ascending",
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "labelPadding": 10,
            "labelAngle": 0,
            "grid": false
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Rank (1 = Most Common)",
          "scale": {
            "domain": [1, 6],
            "reverse": true
          },
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "labelPadding": 8,
            "values": [1, 2, 3, 4, 5, 6],
            "format": "d",
            "grid": true,
            "gridColor": "#E0E0E0"
          }
        },
        "color": {
          "field": "activity",
          "type": "nominal",
          "title": "Online Activity",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": null,
            "labelFontSize": 11,
            "columns": 2,
            "columnPadding": 25,
            "labelLimit": 180
          }
        },
        "detail": {
          "field": "activity"
        },
        "tooltip": [
          {
            "field": "activity",
            "type": "nominal",
            "title": "Online Activity"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Respondents (%)",
            "format": ".1f"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2022,
            "rank": 4.5,
            "label": "Telehealth and working from home swap rankings"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 100,
        "dy": -70,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#444444"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
