{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Internet Access Index Across Australia (2025)",
    "fontSize": 16,
    "anchor": "middle",
    "offset": 18
  },
  "width": 520,
  "height": 380,

  "data": {
    "url": "data/australia_states.json",
    "format": {
      "type": "topojson",
      "feature": "STE_2021_AUST_GDA2020"
    }
  },
  "transform": [
    {
      "filter": "datum.properties.STE_NAME21 !== 'Outside Australia'"
    },
    {
      "calculate": "datum.properties.STE_NAME21 === 'New South Wales' ? 'NSW' : datum.properties.STE_NAME21 === 'Victoria' ? 'VIC' : datum.properties.STE_NAME21 === 'Queensland' ? 'QLD' : datum.properties.STE_NAME21 === 'South Australia' ? 'SA' : datum.properties.STE_NAME21 === 'Western Australia' ? 'WA' : datum.properties.STE_NAME21 === 'Tasmania' ? 'TAS' : datum.properties.STE_NAME21 === 'Australian Capital Territory' ? 'ACT' : datum.properties.STE_NAME21 === 'Northern Territory' ? 'NT' : ''",
      "as": "state_code"
    },
    {
      "lookup": "state_code",
      "from": {
        "data": {
          "url": "data/internet_access_states_2025.csv"
        },
        "key": "state",
        "fields": ["access"]
      }
    },
    {
      "calculate": "datum.properties.STE_NAME21",
      "as": "state_name"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "access",
          "type": "quantitative",
          "title": "Internet Access Index",
          "scale": {
            "type": "threshold",
            "domain": [73, 76, 79],
            "range": [
              "#B4D7EB",
              "#6BAED6",
              "#2171B5",
              "#084081"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 13,
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "access",
            "type": "quantitative",
            "title": "Access Index",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 150,
            "latitude": -35.5,
            "longitude2": 152,
            "latitude2": -35.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#000000",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "longitude2"
        },
        "latitude2": {
          "field": "latitude2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 149.5,
            "latitude": -35.5,
            "label": "ACT: 80.9 (highest)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 30,
        "dy": 0,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#000000"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "view": {"stroke": null}
  }
}
